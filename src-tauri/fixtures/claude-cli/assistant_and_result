#!/bin/sh
# The production stream for a review: a final text-only assistant message, then
# a `result` event that repeats the same answer. Production passes no
# partial-message flag, so there are no text deltas.
cat > /dev/null
printf '{"type":"system","subtype":"init","session_id":"s-review","model":"fixture-model"}\n'
printf '{"type":"assistant","message":{"content":[{"type":"text","text":"Review done.\\n- ISSUE: [high] a.rs:1 - broken\\nVERDICT: CHANGES_REQUESTED"}]}}\n'
printf '{"type":"result","subtype":"success","is_error":false,"session_id":"s-review","result":"Review done.\\n- ISSUE: [high] a.rs:1 - broken\\nVERDICT: CHANGES_REQUESTED"}\n'
exit 0
