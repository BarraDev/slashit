#!/bin/sh
# Runs out of turns the way Claude Code 2.1.283 does: exit 1, nothing on
# stderr, and the reason only in the `result` event, which has `errors` and
# no `result` text.
cat > /dev/null
printf '{"type":"system","subtype":"init","session_id":"s-turns","model":"fixture-model"}\n'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"a.txt"}}]},"session_id":"s-turns"}'
printf '%s\n' '{"type":"result","subtype":"error_max_turns","is_error":true,"num_turns":2,"stop_reason":"tool_use","terminal_reason":"max_turns","errors":["Reached maximum number of turns (1)"],"session_id":"s-turns"}'
exit 1
