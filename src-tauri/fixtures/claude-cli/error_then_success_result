#!/bin/sh
# Reports an error result and then a successful one, and exits 0. An error
# result anywhere in the stream fails the run.
cat > /dev/null
printf '{"type":"system","subtype":"init","session_id":"s-two","model":"fixture-model"}\n'
printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"errors":["the first attempt failed"],"session_id":"s-two"}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"done","session_id":"s-two"}'
exit 0
