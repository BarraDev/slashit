#!/bin/sh
# Reports an error result and then stays alive until something ends it, so a
# killed run has a structured error on record that is not why it ended.
cat > /dev/null
printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"errors":["something failed"],"session_id":"s-err-block"}'
printf '%s\n' "$$" > blocked.pid
exec sleep 300
