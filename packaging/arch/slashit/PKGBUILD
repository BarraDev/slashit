# Maintainer: <set the maintainer before AUR publication>
#
# Source package: builds the tagged upstream release from its GitHub archive,
# following .github/workflows/release.yml (trunk for the frontend, then the
# GUI and daemon with the custom-protocol feature, and the CLI).
# This is a prerelease (v0.0.3, experimental). See packaging/arch/README.md.
# Not built or tested by the packaging lane; see the README for the open items.

pkgname=slashit
pkgver=0.0.3
pkgrel=1
pkgdesc='AI agent workspace manager (Tauri desktop app, built from the tagged source)'
arch=('x86_64')
url='https://github.com/BarraDev/slashit'
license=('MPL-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'libayatana-appindicator'
  'dbus'
)
makedepends=(
  'cargo'
  'rust'
  'rust-wasm'
  'trunk'
  'wasm-bindgen'
  'binaryen'
  'librsvg'
  'pkgconf'
)
conflicts=('slashit-bin')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/BarraDev/slashit/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('42d808247f0114b7d2d54c543377b12c7566abed5f3eaaddae333b3a3e8ae825')

_srcdir="slashit-$pkgver"

prepare() {
  cd "$_srcdir"
  # Crates are fetched from crates.io and verified against the checksums in the
  # tagged Cargo.lock. Nothing is taken from a mutable reference.
  cargo fetch --locked
}

build() {
  cd "$_srcdir"
  export CARGO_TARGET_DIR=target

  # Frontend (Leptos/WASM) into dist/, the directory tauri.conf.json embeds.
  trunk build

  # The CLI, copied to /usr/bin/slashit by the Linux packages upstream.
  cargo build --locked --release -p slashit

  # The GUI and the daemon. custom-protocol embeds dist/ into the binary, as
  # `cargo tauri build` does; a plain cargo build loads nothing.
  cargo build --locked --release -p slashit-ui --features tauri/custom-protocol \
    --bin slashit-ui --bin slashitd
}

package() {
  cd "$_srcdir"

  install -Dm755 target/release/slashit-ui "$pkgdir/usr/bin/slashit-ui"
  install -Dm755 target/release/slashitd "$pkgdir/usr/bin/slashitd"
  install -Dm755 target/release/slashit "$pkgdir/usr/bin/slashit"

  # The release does not ship a desktop file in the source tree; this is the
  # entry the upstream .deb installs.
  cat > "$srcdir/SlashIt.desktop" <<'DESKTOP'
[Desktop Entry]
Categories=
Comment=AI agent workspace manager - Tauri v2 desktop app with Kanban, terminals, and queue execution
Exec=slashit-ui
StartupWMClass=slashit-ui
Icon=slashit-ui
Name=SlashIt
Terminal=false
Type=Application
DESKTOP
  install -Dm644 "$srcdir/SlashIt.desktop" "$pkgdir/usr/share/applications/SlashIt.desktop"

  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/slashit-ui.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/slashit-ui.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256@2/apps/slashit-ui.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
