# SPDX-License-Identifier: MPL-2.0
# Optional systemd user unit for the isolated SlashIt dogfood instance.
#
# scripts/supervise-dogfood.sh works on any system and is the primary
# mechanism; this unit only adds automatic restarts and journal logging where
# a systemd user session is available. The unit runs the script's `run` verb:
# the binary and CLI locations are resolved from the checkout the script
# belongs to (its own target/debug), so the layout is declared in exactly ONE
# place — the script. Adjust the ExecStart path to the workspace checkout that
# builds the dogfood binary. The Environment= entries are explicit on
# purpose: a user service inherits little from the desktop session, and the
# instance must never fall back to the default XDG directories derived from
# HOME. They mirror the script's declaration; `run` re-checks the ambient
# values against it and refuses when they disagree, and it refuses while an
# instance already answers on the control socket — the unit fails visibly
# instead of doubling an instance the service manager does not know about.
#
# Lifecycle: while the unit owns the instance, start/stop/restart belong to
# systemctl (`daemon-reload` after edits; `status` shows the service).
# scripts/supervise-dogfood.sh status and verify keep working, because they
# check the control socket, not the unit; a scripted start correctly refuses
# while the unit's instance answers on the socket. systemctl stop signals the
# process directly, which does not run the application's own shutdown; prefer
# `slashit --endpoint ... quit` against this instance, or stop the unit and
# accept that integrated terminals may outlive it.
#
# Install and use (adjust ExecStart first):
#
#   install -Dm644 scripts/slashit-dogfood.service \
#     ~/.config/systemd/user/slashit-dogfood.service
#   systemctl --user daemon-reload
#   systemctl --user start slashit-dogfood
#
# Backups: only the script's `restart` takes a verified backup, and it needs a
# running instance. After `systemctl --user stop` it refuses (nothing to
# restart) and backs up nothing, so take the backup by running `restart` while
# the instance is up.
#
# Deployment blocker: do not enable this unit until the stale-endpoint recovery
# is resolved. After a crash or a forced stop the control socket remains, `run`
# refuses it as unverifiable, and Restart=on-failure loops on that refusal.

[Unit]
Description=SlashIt isolated dogfood instance
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="XDG_CONFIG_HOME=%h/.local/state/slashit-dogfood/config"
Environment="XDG_DATA_HOME=%h/.local/state/slashit-dogfood/data"
Environment="XDG_CACHE_HOME=%h/.local/state/slashit-dogfood/cache"
Environment="XDG_STATE_HOME=%h/.local/state/slashit-dogfood"
Environment="XDG_RUNTIME_DIR=/run/user/%U/slashit-dogfood"
Environment="GH_CONFIG_DIR=%h/.config/gh"
ExecStartPre=/usr/bin/install -d -m 0700 \
  %h/.local/state/slashit-dogfood /run/user/%U/slashit-dogfood
ExecStart=%h/Repo/Tauri/slashit/workspaces/slashit-dogfood-git/scripts/supervise-dogfood.sh run
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=graphical-session.target
