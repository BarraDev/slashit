#!/bin/sh
# A stand-in for the Claude Code CLI, used by the SlashIt acceptance journeys.
# It never contacts a model. It records how it was called, including the prompt
# an agent run reads from stdin, and emits the smallest stream-json exchange the
# real runner treats as a success.
set -e

if [ -z "$SLASHIT_FAKE_AGENT_MARKERS" ]; then
    echo "fake claude: SLASHIT_FAKE_AGENT_MARKERS is not set" >&2
    exit 97
fi

# Claim this invocation's place in the order invocations started, before
# anything else happens. `mkdir` refuses an existing directory and creates a
# missing one in a single indivisible step, so two invocations starting at the
# same moment can never be handed the same number, and the numbers are handed
# out in the order invocations reach this line. That order is what the record's
# name carries; a name made up by `mktemp` would be unique but say nothing
# about when the run happened.
sequence="$SLASHIT_FAKE_AGENT_MARKERS/.sequence"
mkdir -p "$sequence"
position=1
while ! mkdir "$sequence/$position" 2>/dev/null; do
    position=$((position + 1))
done

# The session id is echoed back, so the caller can tie this run to the one it
# asked for rather than to any run at all. The prompt flag is noted in the same
# pass: it is what separates an agent run from `--version`, which a real CLI
# also answers without doing any work. The allowed tools are what tell the
# coding agent (the only role given Bash) from the review and fix agents.
session=""
take_next=""
take_tools=""
is_run=""
is_coding=""
for arg in "$@"; do
    if [ -n "$take_next" ]; then
        session="$arg"
        take_next=""
        continue
    fi
    if [ -n "$take_tools" ]; then
        case "$arg" in
            *Bash*) is_coding="yes" ;;
        esac
        take_tools=""
        continue
    fi
    case "$arg" in
        --session-id) take_next="yes" ;;
        --allowedTools) take_tools="yes" ;;
        -p) is_run="yes" ;;
    esac
done

# Progress mode, when a journey asked for it: a coding run narrates what it is
# doing the way Claude Code does without partial messages -- whole `assistant`
# messages, one holding text and one naming a tool -- so the product's own
# stream parser and live events are what a journey watches. Only coding runs
# narrate; the review and fix agents answer exactly as they always did.
progress=""
if [ -n "$SLASHIT_FAKE_AGENT_PROGRESS" ] && [ -n "$is_run" ] && [ -n "$is_coding" ]; then
    progress="yes"
fi

say() {
    printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$1"
}

use_tool() {
    printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_fake","name":"%s","input":{}}]}}\n' "$1"
}

# An agent run reads its prompt from stdin to EOF before it answers, as
# `claude -p` without a prompt argument does. It is kept under the same
# position as the record, and written before the record appears, so a visible
# record always has its prompt next to it.
if [ -n "$is_run" ]; then
    mkdir -p "$SLASHIT_FAKE_AGENT_MARKERS/.prompts"
    prompt_file="$SLASHIT_FAKE_AGENT_MARKERS/.prompts/$position"
    cat > "$prompt_file"
fi

# Written in a staging directory and moved into place, because the test polls
# this directory while the agent is running: `mktemp` creates the file before
# anything is in it, so a reader could otherwise see a record that exists but
# is still empty. A rename within one filesystem is atomic, so only finished
# records are ever visible.
staging="$SLASHIT_FAKE_AGENT_MARKERS/.staging"
mkdir -p "$staging"
record=$(mktemp "$staging/XXXXXX")
printf '%s\0' "$PWD" "$@" > "$record"
mv "$record" "$SLASHIT_FAKE_AGENT_MARKERS/invocation-$position"

printf '{"type":"system","subtype":"init","session_id":"%s","model":"slashit-fake-agent"}\n' "$session"

if [ -n "$progress" ]; then
    say "fake agent step one: reading the task"
    use_tool "Read"
fi

# Leave work behind, when a journey asked for it. Written into "$PWD", which is
# the directory the product started this run in -- the task's worktree -- so
# the executor's own commit picks it up like any other change an agent makes.
if [ -n "$SLASHIT_FAKE_AGENT_WRITE_FILE" ] && [ -n "$is_run" ]; then
    printf '%s' "work produced by the fake agent
" > "$SLASHIT_FAKE_AGENT_WRITE_FILE"
fi

# The same, with a file of its own per worktree, for a journey whose tasks must
# each leave commits the others do not hold (a stacked task whose own work has
# to differ from its parent's). Named after the worktree's directory, which is
# the task's branch name.
if [ -n "$SLASHIT_FAKE_AGENT_WRITE_OWN_FILE" ] && [ -n "$is_run" ]; then
    printf '%s' "work produced by the fake agent
" > "agent-work-$(basename "$PWD").txt"
fi

# Blocking mode, when a journey asked for it. A run that blocks gets a release
# pipe of its own: it creates the pipe and opens it before it announces itself,
# and takes both away again once its release has arrived.
#
# The order is the whole contract. What a test acts on is the announcement, and
# a release sent to a pipe nobody has open is refused outright rather than
# queued -- so a run that announced itself before it could be read from would
# be advertising a run that cannot yet be released. Read-write is the mode that
# makes that order possible at all: opening the pipe read-only would block here
# waiting for a writer that only ever arrives with the release.
#
# One pipe per run rather than one shared by all of them, because a release
# written to a shared pipe carries no address: it would be taken by whichever
# waiting run the kernel handed it to, which is not necessarily the one it was
# sent for. `$$` is this process, because the product exec'd this script
# directly.
if [ -n "$SLASHIT_FAKE_AGENT_BLOCK_DIR" ] && [ -n "$is_run" ]; then
    processes="$SLASHIT_FAKE_AGENT_MARKERS/.processes"
    mkdir -p "$processes/.staging"
    pidfile=$(mktemp "$processes/.staging/XXXXXX")
    name=${pidfile##*/}
    printf '%s\n' "$$" > "$pidfile"

    pipe="$SLASHIT_FAKE_AGENT_BLOCK_DIR/$name"
    mkfifo "$pipe"
    exec 3<> "$pipe"

    # Staged and renamed for the same reason the invocation record is: a reader
    # must never see a record that exists but is still empty.
    mv "$pidfile" "$processes/$name"

    # Blocks in the kernel until this run's own release arrives. A failed read
    # is a released or closed pipe, not a reason to abandon the run. In
    # progress mode an `advance` line is not a release: the run takes its next
    # step and goes back to waiting.
    while read -r command <&3; do
        if [ "$command" = "advance" ] && [ -n "$progress" ]; then
            say "fake agent step two: editing the code"
            use_tool "Edit"
            continue
        fi
        break
    done

    # Stop being releasable in the same breath as stopping to wait, so that an
    # announced run is one that is still owed a release and nothing else.
    rm -f "$processes/$name" "$pipe"
    exec 3<&-
fi

# Absent means nothing is scripted to fail, so a journey that does not set this
# sees exactly the behaviour it saw before this existed -- not even the
# bookkeeping directory below is created.
failing=${SLASHIT_FAKE_AGENT_FAILING_RUNS:-0}

if [ -n "$is_run" ] && [ "$failing" -gt 0 ]; then
    # Claim the next run number. `mkdir` refuses an existing directory and
    # creates a missing one in a single indivisible step, so two agents
    # starting at the same moment can never be handed the same number -- and
    # unlike a counter file, there is no read-modify-write to lose.
    runs="$SLASHIT_FAKE_AGENT_MARKERS/.runs"
    mkdir -p "$runs"
    ordinal=1
    while ! mkdir "$runs/$ordinal" 2>/dev/null; do
        ordinal=$((ordinal + 1))
    done

    if [ "$ordinal" -le "$failing" ]; then
        # A well-formed result that reports failure, with a zero exit status:
        # the agent ran and said it could not do the work, which is a different
        # thing from the agent crashing.
        if [ -n "$progress" ]; then
            # A failure explained over several lines, as an agent reports one.
            printf '{"type":"result","subtype":"error_during_execution","is_error":true,"session_id":"%s","result":"fake agent was scripted to fail this run","errors":["the change could not be applied: 3 of 12 checks failed","parser::rejects_empty_input expected an error and got none","stopping here so a person can decide how to continue"]}\n' "$session"
            exit 0
        fi
        printf '{"type":"result","subtype":"error_during_execution","is_error":true,"session_id":"%s","result":"fake agent was scripted to fail this run"}\n' "$session"
        exit 0
    fi
fi

coordinator_position=0
if [ -n "$is_run" ] && grep -q '"current_message"' "$prompt_file" 2>/dev/null; then
    coordinator_position=1
    while ! mkdir "$SLASHIT_FAKE_AGENT_MARKERS/.coordinator-$coordinator_position" 2>/dev/null; do
        coordinator_position=$((coordinator_position + 1))
    done
fi

fail_after_worker=${SLASHIT_FAKE_COORDINATOR_FAIL_AFTER_WORKER:-0}
if [ "$fail_after_worker" -gt 0 ] &&
    grep -q '"returned_action"' "$prompt_file" 2>/dev/null &&
    mkdir "$SLASHIT_FAKE_AGENT_MARKERS/.returned-action-failed" 2>/dev/null; then
    printf '{"type":"result","subtype":"error_during_execution","is_error":true,"session_id":"%s","result":"fake Coordinator was scripted to fail this run"}\n' "$session"
    exit 0
fi

result="fake agent completed without changing the repository"
if [ -n "$is_run" ] && grep -q '"returned_action"' "$prompt_file" 2>/dev/null; then
    result='{"type":"reply","text":"Coordinator reviewed the Worker result."}'
elif [ -n "$is_run" ] && grep -q '"approved_request"' "$prompt_file" 2>/dev/null; then
    result="fake Worker completed approved work"
elif [ -n "$is_run" ] && grep -q '"current_message"' "$prompt_file" 2>/dev/null; then
    if [ "$coordinator_position" -gt 2 ]; then
        result='{"type":"reply","text":"Fake Coordinator reply."}'
    else
        result=${SLASHIT_FAKE_COORDINATOR_OUTPUT:-'{"type":"reply","text":"Fake Coordinator reply."}'}
        if [ "$result" = "delegate_to_task" ]; then
            target=${SLASHIT_FAKE_COORDINATOR_TARGET_TASK_ID:-}
            if [ -z "$target" ] && [ -r "$SLASHIT_FAKE_AGENT_MARKERS/.coordinator-target/id" ]; then
                target=$(cat "$SLASHIT_FAKE_AGENT_MARKERS/.coordinator-target/id")
            fi
            if [ -z "$target" ]; then
                task_object=$(grep -o '{[^}]*"title":"Existing Task"[^}]*}' "$prompt_file" | head -n 1)
                target=$(printf '%s\n' "$task_object" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
            fi
            if [ -z "$target" ]; then
                echo "fake Coordinator could not find the requested target Task" >&2
                exit 2
            fi
            result="{\"type\":\"delegate_to_task\",\"text\":\"The existing Task is the right execution boundary.\",\"target_task_id\":\"$target\",\"request\":\"Add the approved marker.\"}"
        fi
    fi
fi
escaped_result=$(printf '%s' "$result" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
printf '{"type":"result","subtype":"success","is_error":false,"session_id":"%s","result":"%s"}\n' "$session" "$escaped_result"
exit 0
